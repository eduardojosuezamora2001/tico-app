# ------------------------------------------------------------------
# Plaza de Comercios Digital - variables de entorno
# Copia este archivo a `.env` en la raiz del monorepo y completa los valores.
# Un solo `.env` alimenta a `apps/api` (dotenv) y a `apps/web` (Vite envDir).
# ------------------------------------------------------------------

# Supabase (Dashboard > Project Settings > API)
SUPABASE_URL=https://ceafdnvkfziidtgxflyw.supabase.co
# Publishable key (segura para el cliente). Las "anon" keys legadas tambien funcionan.
SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key. SOLO backend. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek (Traduccion con IA) - Fase 6
DEEPSEEK_API_KEY=

# Google Maps - Fase 7
GOOGLE_MAPS_API_KEY=

# Backend (apps/api)
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Redis (Upstash) - Fase 3 (chat)
REDIS_URL=

# Frontend (apps/web) - Vite solo expone variables con prefijo VITE_
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://ceafdnvkfziidtgxflyw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
