/**
 * Cloudflare Workers — static assets for the Vite SPA (`apps/web`).
 *
 * Workers Builds (dashboard) recommended settings:
 * - Branch:          cloudflare
 * - Root directory:  /
 * - Build command:   pnpm cf:build
 * - Deploy command:  pnpm cf:deploy
 * - Build vars:      SKIP_DEPENDENCY_INSTALL=0 (or omit)
 *                    PNPM_VERSION=12.6.0
 *                    VITE_API_URL, VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, …
 *
 * Local: `pnpm --filter web deploy`
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tico-web",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
